cabal-version:      3.0
name:               sport
version:            0.1.0.0
synopsis:           unix serial port
description:        unix serial port
license:            MIT
license-file:       LICENSE
author:             Standard Semiconductor
maintainer:         standardsemiconductor@gmail.com
copyright:          David Cox
category:           System
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

library
  ghc-options:      -Wall -O2
  default-language: Haskell2010
  hs-source-dirs:   lib
  exposed-modules:  Sport,
                    Sport.Main,
                    Sport.Serial
  build-depends:    base < 5,
                    unix

executable sport
  ghc-options:      -Wall -O2 -threaded
  default-language: Haskell2010
  hs-source-dirs:   exe
  main-is:          Main.hs
  build-depends:    base,
                    sport

test-suite test
  ghc-options:      -Wall
  default-language: Haskell2010
  hs-source-dirs:   test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  build-depends:    base,
                    sport
